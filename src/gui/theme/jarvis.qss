/* DesktopAI v2.0 — Jarvis HUD Stylesheet */
/* File: src/gui/theme/jarvis.qss */

/* ── Global ──────────────────────────────────────────────────────── */
QWidget {
    background-color: #050810;
    color: #E0F7FA;
    font-family: 'Rajdhani', 'Segoe UI', sans-serif;
    font-size: 14px;
    font-weight: 500;
}

QMainWindow {
    background-color: #050810;
}

/* ── Sidebar ─────────────────────────────────────────────────────── */
QListWidget#Sidebar {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #050810, stop:1 #0A1120);
    border: none;
    border-right: 1px solid #00D4FF;
    outline: none;
}

QListWidget#Sidebar::item {
    padding: 14px 20px;
    border-radius: 4px;
    margin: 4px 10px;
    color: #80DEEA;
    font-family: 'Orbitron', sans-serif;
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 1.5px;
    text-transform: uppercase;
}

QListWidget#Sidebar::item:hover {
    background-color: rgba(0, 212, 255, 0.08);
    color: #00FFFF;
    border: 1px solid rgba(0, 212, 255, 0.3);
}

QListWidget#Sidebar::item:selected {
    background-color: rgba(0, 212, 255, 0.15);
    color: #00FFFF;
    border: 1px solid #00D4FF;
    font-weight: 700;
}

/* ── HUD Cards / Panels ──────────────────────────────────────────── */
QFrame#HUDCard, QFrame#HUDPanel {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #0A1120, stop:1 #050810);
    border: 1px solid #00D4FF;
    border-radius: 8px;
}

QFrame#HUDCard {
    /* Glowing corners effect via box-shadow simulation */
    border-top: 1px solid #00FFFF;
    border-left: 1px solid #00D4FF;
    border-bottom: 1px solid #0099CC;
    border-right: 1px solid #0099CC;
}

/* ── Buttons ─────────────────────────────────────────────────────── */
QPushButton {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #0F1A2E, stop:1 #0A1120);
    color: #00D4FF;
    border: 1px solid #00D4FF;
    border-radius: 4px;
    padding: 10px 24px;
    font-family: 'Orbitron', sans-serif;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 1.5px;
    text-transform: uppercase;
}

QPushButton:hover {
    background-color: rgba(0, 212, 255, 0.15);
    color: #00FFFF;
    border: 1px solid #00FFFF;
}

QPushButton:pressed {
    background-color: rgba(0, 212, 255, 0.25);
    border: 1px solid #00FFFF;
}

QPushButton#PrimaryButton {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #00D4FF, stop:1 #0099CC);
    color: #000000;
    border: 1px solid #00FFFF;
    font-weight: 700;
}

QPushButton#PrimaryButton:hover {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #00FFFF, stop:1 #00D4FF);
    color: #000000;
}

QPushButton#PrimaryButton:pressed {
    background-color: #0099CC;
}

/* ── Inputs ──────────────────────────────────────────────────────── */
QLineEdit, QTextEdit, QPlainTextEdit {
    background-color: #060B15;
    color: #E0F7FA;
    border: 1px solid #00D4FF;
    border-radius: 4px;
    padding: 10px 14px;
    font-family: 'Rajdhani', sans-serif;
    font-size: 14px;
    selection-background-color: #00D4FF;
    selection-color: #000000;
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus {
    border: 1px solid #00FFFF;
    background-color: #0A1120;
}

/* ── Scrollbars ──────────────────────────────────────────────────── */
QScrollBar:vertical {
    background-color: #050810;
    width: 8px;
    border: none;
}

QScrollBar::handle:vertical {
    background-color: #00D4FF;
    border-radius: 4px;
    min-height: 40px;
}

QScrollBar::handle:vertical:hover {
    background-color: #00FFFF;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    background-color: #050810;
    height: 8px;
    border: none;
}

QScrollBar::handle:horizontal {
    background-color: #00D4FF;
    border-radius: 4px;
    min-width: 40px;
}

/* ── Typography ──────────────────────────────────────────────────── */
QLabel#DisplayTitle {
    font-family: 'Orbitron', sans-serif;
    font-size: 48px;
    font-weight: 700;
    color: #00FFFF;
    letter-spacing: 4px;
}

QLabel#Title {
    font-family: 'Orbitron', sans-serif;
    font-size: 28px;
    font-weight: 700;
    color: #00D4FF;
    letter-spacing: 2px;
}

QLabel#Subtitle {
    font-family: 'Rajdhani', sans-serif;
    font-size: 16px;
    color: #80DEEA;
    letter-spacing: 1px;
}

QLabel#Mono {
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    color: #4FC3F7;
}

QLabel#StatusText {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    color: #00D4FF;
    letter-spacing: 1px;
}

/* ── Progress Bars ───────────────────────────────────────────────── */
QProgressBar {
    background-color: #060B15;
    border: 1px solid #00D4FF;
    border-radius: 4px;
    text-align: center;
    color: #00FFFF;
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
}

QProgressBar::chunk {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #0099CC, stop:1 #00FFFF);
    border-radius: 3px;
}

/* ── Tabs ────────────────────────────────────────────────────────── */
QTabWidget::pane {
    border: 1px solid #00D4FF;
    background-color: #0A1120;
}

QTabBar::tab {
    background-color: #050810;
    color: #80DEEA;
    border: 1px solid #00D4FF;
    padding: 8px 20px;
    font-family: 'Orbitron', sans-serif;
    font-size: 11px;
    letter-spacing: 1px;
}

QTabBar::tab:selected {
    background-color: #0A1120;
    color: #00FFFF;
    border-bottom: 2px solid #00FFFF;
}

/* ── Status Bar ──────────────────────────────────────────────────── */
QStatusBar {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #0A1120, stop:1 #050810);
    border-top: 1px solid #00D4FF;
    color: #00D4FF;
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    padding: 4px 12px;
}

/* ── Tooltips ────────────────────────────────────────────────────── */
QToolTip {
    background-color: #0A1120;
    color: #00FFFF;
    border: 1px solid #00D4FF;
    padding: 6px 10px;
    font-family: 'Rajdhani', sans-serif;
}